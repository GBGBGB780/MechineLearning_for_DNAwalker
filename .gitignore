# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.hypothesis/

# Virtual environments
.venv/
venv/
env/

# Model outputs and data (large binary files)
artifacts/
*.pth
*.mat
*.npz
*.pkl

# Generated outputs. Curated, path-sanitized evidence lives in docs/evidence/.
results/

# Experimental workbooks are local inputs until redistribution rights and
# source statements are documented. Their expected names and hashes are in
# data/experimental/README.md.
data/experimental/*.xlsx

# Locally preserved historical experiment snapshots; not active source code.
archive/experiments/

# Private project records and submission deliverables.
docs/report/
scripts/sync_closeout_deliverables.py

# Generated prediction / verification artifacts (regenerated by predict*.py / verify.py)
matlab_input_params.txt
matlab_input_params_verify.png
*_verify.png

# IDE / tooling
.idea/
.vscode/*
.claude/
.kiro/

# OS
.DS_Store
Thumbs.db

# Document backups (committed copies live alongside main file)
*.bak.docx
*.bak

# The validation-selected application bundle is intentionally published.
# All other generated datasets, checkpoints, scalers, and manifests stay ignored.
!artifacts/
artifacts/*
!artifacts/application/
!artifacts/application/**
